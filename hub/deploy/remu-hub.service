# Remu hub: LAN API, gate pipeline and cloud sync. Installed by scripts/build_pi_image.sh.
[Unit]
Description=Remu hub
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target

[Service]
Type=notify
NotifyAccess=main
User=remu
Group=remu
EnvironmentFile=/etc/remu/hub.env
# The shop key stays root-owned (0600) in /etc/remu; systemd hands it to the service privately.
LoadCredential=shop.key:/etc/remu/shop.key
Environment=REMU_SHOP_KEY_PATH=%d/shop.key
Environment=REMU_STATE_DIR=/var/lib/remu/state
# Fetch the unlock token from the cloud and open the LUKS data directory (runs as root).
ExecStartPre=+/opt/remu/venv/bin/remu-hub unlock
ExecStart=/opt/remu/venv/bin/remu-hub serve
Restart=always
RestartSec=10
WatchdogSec=60
TimeoutStartSec=infinity
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/remu
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
