# /etc/remu/hub.env on the Pi (root:remu, mode 0640). No secret lives here: the shop key is
# /etc/remu/shop.key (root, 0600) and the device token is /var/lib/remu/state/device.token.
REMU_SHOP_ID=
REMU_CLOUD_URL=https://remu.example.in
REMU_RTSP_GATE_URL=
REMU_RTSP_COUNTER_URL=
REMU_DATA_DIR=/var/lib/remu/data
# The data directory must be the mounted LUKS volume; the hub refuses a plain folder.
REMU_REQUIRE_ENCRYPTED=1
REMU_MODELS_DIR=/opt/remu/models
REMU_MODEL_PACK=buffalo_l
REMU_MATCH_THRESHOLD=0.45
REMU_FRAMES_REQUIRED=3
REMU_FRAMES_WINDOW=5
REMU_ALERT_COOLDOWN_MINUTES=10
REMU_CLIP_RETENTION_DAYS=30
REMU_MEMBER_EXPIRY_DAYS=1095
REMU_LOG_LEVEL=INFO
SENTRY_DSN=
