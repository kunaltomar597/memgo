# Remu environment variables. Names only, no real values. Written 2026-10-18 from brief section 17.
# Each component copies its own section to its own local env file:
#   hub   -> hub/.env in development; /etc/remu/hub.env (root-only) on the Pi
#   cloud -> cloud/.env.local in development; Vercel environment settings in preview and production
#   app   -> Gradle build configuration, see the App section
# No env file is ever committed. .gitignore covers .env, .env.*, *.env, hub.env and google-services.json; only this file is tracked.
# A variable with a value below carries the default from the brief. Every other variable is empty on purpose.

# ---------- Hub (hub/, Python 3.11) ----------

# Id of the shop this hub serves; matches shops.id on the hub and in the cloud.
REMU_SHOP_ID=
# Bearer token issued by the cloud at pairing; kept root-only on the hub, never logged, synced or shown in the app.
REMU_DEVICE_TOKEN=
# Base URL of the cloud the hub calls; outbound HTTPS only, the cloud never calls the hub.
REMU_CLOUD_URL=
# RTSP URL of the gate stream from the DVR, NVR or dedicated gate IP camera; make fake-camera serves one in development.
REMU_RTSP_GATE_URL=
# Optional RTSP URL of the counter CCTV camera; leave empty when there is none.
REMU_RTSP_COUNTER_URL=
# Encrypted data directory holding SQLite and clips; /var/lib/remu on the Pi, a plain local folder in development (assumed hub/data).
REMU_DATA_DIR=
# InsightFace model pack for detection, embedding and the age gate; default buffalo_l, fallback buffalo_sc on weak CPUs.
REMU_MODEL_PACK=buffalo_l
# Cosine similarity needed for a match; default 0.45, changed only after the evaluation harness in tests/eval/ passes.
REMU_MATCH_THRESHOLD=0.45
# Consecutive frames that must agree on the same member before an alert; default 3.
REMU_FRAMES_REQUIRED=3
# Size of the consecutive-frame window the agreement is counted in; default 5.
REMU_FRAMES_WINDOW=5
# Minutes between two alerts for the same member; default 10.
REMU_ALERT_COOLDOWN_MINUTES=10
# Days a 5-second match clip is kept before the nightly job deletes it; default 30.
REMU_CLIP_RETENTION_DAYS=30
# Days a member may go unseen before the nightly job deletes the template and logs it; default 1095.
REMU_MEMBER_EXPIRY_DAYS=1095
# Verbosity of the structured logs (ids only, never values); DEBUG is never used in a shop; assumed INFO when empty.
REMU_LOG_LEVEL=
# Sentry DSN for error tracking with PII sending off; empty disables it. OPEN: Sentry stores events outside India, confirm with the lawyer or self-host.
SENTRY_DSN=
# Development default: the data directory. On the Pi: /var/lib/remu/state (device token and pairing code, outside the LUKS volume).
REMU_STATE_DIR=
# Development default: <state dir>/shop.key. On the Pi systemd passes /etc/remu/shop.key as a credential.
REMU_SHOP_KEY_PATH=
# DVR login used by GET /discover when the owner has not entered one in the app yet.
REMU_DVR_USER=
REMU_DVR_PASSWORD=
# LAN API bind address and port. Defaults 0.0.0.0 and 8443.
REMU_API_HOST=
REMU_API_PORT=
# Faces narrower than this many pixels (in the 640 by 360 frame) are ignored. Default 40.
REMU_MIN_FACE_PX=

# ---------- Cloud (cloud/, Next.js 15, TypeScript, Supabase, Vercel) ----------

# Supabase project URL, Mumbai region (AWS ap-south-1); safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon key; safe for the browser because Row Level Security guards every table.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key; server code only, never in a client component, never under a NEXT_PUBLIC_ name.
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string for migrations and server-side jobs.
DATABASE_URL=
# Supabase JWT secret; lets the cloud check owner tokens locally (HS256). Unset: the cloud asks Supabase.
SUPABASE_JWT_SECRET=
# Shared key for the Remu team's ops routes (X-Remu-Ops-Key) and the pg_cron jobs. Ops routes refuse all calls when unset.
OPS_API_KEY=
# Optional: where ops alerts (hub silent 15 minutes, hub locked) are POSTed. The channel is OPEN.
OPS_ALERT_WEBHOOK_URL=
# Optional: Meta Graph API version for WhatsApp calls. Default v21.0.
WHATSAPP_GRAPH_API_VERSION=
# Test only: base URL of a mock Graph API for local end-to-end runs. Leave empty in every real environment.
WHATSAPP_GRAPH_BASE_URL=
# WhatsApp Cloud API phone number id of the dedicated sending number.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account id that owns the number and the approved templates.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Access token for the WhatsApp Cloud API; server only.
WHATSAPP_ACCESS_TOKEN=
# Token we choose for the webhook verification handshake on GET /api/webhooks/whatsapp.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret used to check X-Hub-Signature-256 on every webhook before the body is parsed.
WHATSAPP_APP_SECRET=
# Name of the approved utility template for the English member notice, version wa-v1.0, with the thumbs-up quick-reply button.
WHATSAPP_TEMPLATE_MEMBER_NOTICE_EN=
# Name of the approved utility template for the Hindi member notice, version wa-v1.0, with the thumbs-up quick-reply button.
WHATSAPP_TEMPLATE_MEMBER_NOTICE_HI=
# Firebase service account JSON, base64 encoded, for sending FCM data messages that carry ids only.
FCM_SERVICE_ACCOUNT_JSON_BASE64=
# Secret the cloud uses to issue pairing codes and derive the hub's data unlock token.
HUB_PAIRING_SECRET=
# Private key that signs consent exports (PDF and CSV) so a tampered export can be detected.
CONSENT_EXPORT_SIGNING_KEY=
# Sentry DSN for the cloud, PII sending off, request bodies stripped; empty disables it.
SENTRY_DSN=
# Razorpay key id for subscription billing; later phase, leave empty in MVP.
RAZORPAY_KEY_ID=
# Razorpay key secret for subscription billing; later phase, leave empty in MVP.
RAZORPAY_KEY_SECRET=

# ---------- App (app/, Android, Kotlin) ----------

# Base URL of the cloud, baked into BuildConfig per flavour at build time; the app reads no env file at runtime (assumed: Gradle reads it from the environment or local.properties).
REMU_CLOUD_URL=
# FCM needs google-services.json from the Firebase console inside the app module; it is a file, not a variable, and is never committed.
