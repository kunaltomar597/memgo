# Remu .gitignore. Secrets, member data, model packs, clips and build output never enter the repository.

# ---- Env files: everything except the template ----
.env
.env.*
*.env
hub.env
!.env.example

# ---- Python (hub/, tests/, scripts/) ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.eggs/
build/
dist/
pip-wheel-metadata/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Node and Next.js (cloud/) ----
node_modules/
.next/
out/
.vercel/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
cloud/supabase/.temp/
cloud/supabase/.branches/

# ---- Android and Gradle (app/) ----
.gradle/
app/build/
app/*/build/
app/.cxx/
app/captures/
app/.kotlin/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.jks
*.keystore
google-services.json

# ---- Playwright and test outputs ----
test-results/
playwright-report/
playwright/.cache/
blob-report/
app/maestro/.maestro/
tests/eval/data/
tests/eval/reports/
*.junit.xml

# ---- Model packs and weights (fetched by make setup, never committed) ----
hub/models/
/models/
*.onnx
*.pth
*.pt
*.tflite
*.safetensors
.insightface/

# ---- Hub data directories, clips and fixture video (contain member data or faces) ----
hub/data/
/data/
/var/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.enc
*.mp4
*.mkv
*.avi
*.mov
*.h264
scripts/fixtures/

# ---- Keys, certificates and tokens ----
*.key
*.pem
*.crt
*.cer
*.csr
*.p12
*.pfx
shop.key
device.token
secrets/

# ---- macOS and editors ----
.DS_Store
.AppleDouble
._*
Thumbs.db
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
